<?xml version="1.0" encoding="UTF-8"?>
<info>
    <!-- Wood Life -->
    <div 
        id="wood-life" 
        x="35%" y="50%" 
        visible="false"
    >
        <label 
            id="wood-life-damage"
            x="0" y="0" 
            scale="1.0" 
            color="0.871, 0.580, 0.949"
            textShadow="2,2 0 0,0,0,1.0"
            visible="true"
        >
            {treeDataIndex} took {damage} damage
        </label>
        <label 
            id="wood-life-health"
            x="0" y="20"
            scale="1.0"
            color="1.0, 1.0, 1.0"
            visible="true"
        >
            Health: {currHealth}/{treeDataHealth}
        </label>
    </div>

    <!-- Axe Level (Low) -->
    <div 
        id="axe-level-low" 
        x="50%" y="50%" 
        visible="false"
    >
        <label 
            id="axe-level-low-content"
            x="0" y="0"
            scale="1.0"
            color="1.0, 0.2, 0.2"
            textShadow="2,2 0 0,0,0,1.0"
            visible="true"
        >
            Axe {axeLevel} too low for tree level {treeLevel}
        </label>
    </div>
</info>