<?xml version="1.0" encoding="UTF-8"?>
<info>
    <!-- Wood Life -->
    <div 
        id="wood-life" 
        x="35%" y="85%"
        visible="false"
    >
        <label 
            id="wood-life-damage-c"
            x="0" y="0" 
            scale="1.0" 
            textShadow="2,2 0 0,0,0,1.0"
            visible="true"
            fontFamily="playpen"
        >
            Tree {treeLevel} took {damage} damage
        </label>
        <label 
            id="wood-life-health"
            x="3.5%" y="5%"
            scale="1.0"
            color="1.0, 1.0, 1.0"
            textShadow="2,2 0 0,0,0,1.0"
            visible="true"
            fontFamily="playpen"
        >
            Health: {currHealth}/{treeDataHealth}
        </label>
    </div>

    <!-- Axe Level (Low) -->
    <div 
        id="axe-level-low" 
        x="35%" y="90%" 
        visible="false"
    >
        <label 
            id="axe-level-low-content"
            x="0" y="0"
            scale="1.0"
            color="0.5, 0.5, 0.5"
            textShadow="2,2 0 0,0,0,1.0"
            visible="true"
            fontFamily="playpen"
        >
            Axe {axeLevel} too low for Tree {treeLevel}!
        </label>
    </div>

    <!-- Wood Collected -->
     <div 
        id="wood-collected" 
        x="35%" y="90%" 
        visible="false"
    >
        <label 
            id="wood-collected-content-c"
            x="0" y="0"
            scale="1.0"
            textShadow="2,2 0 0,0,0,1.0"
            visible="true"
            fontFamily="playpen"
        >
            + {actualWood} wood!
        </label>
    </div>
</info>