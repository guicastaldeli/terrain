<?xml version="1.0" encoding="UTF-8"?>
<main_screen>
    <img
        id="title" 
        src="main/logo.png"
        x="0" y="100" 
        width="400" height="80"
        color="0.871, 0.580, 0.949"
        textShadow="2,2 0 0,0,0,1.0"
    >
    </img>

    <button 
        id="continueBtn" 
        x="50" y="220" 
        scale="1.0" 
        color="1.0,1.0,1.0" 
        action="continue"
        fontFamily="comic_sans"
        hoverTextColor="0.5, 0.5, 0.5, 1.0"
        textShadow="2,2 0 0,0,0,1.0"
        width="11.5%" height="7%"
    >
        Continue
    </button>
    <button 
        id="startBtn" 
        x="50" y="300" 
        scale="1.0" 
        color="1.0,1.0,1.0" 
        action="start"
        fontFamily="comic_sans"
        hoverTextColor="0.5, 0.5, 0.5, 1.0"
        textShadow="2,2 0 0,0,0,1.0"
    >
        Start
    </button>
    <button 
        id="loadBtn" 
        x="50" y="380" 
        scale="1.0" 
        color="1.0,1.0,1.0" 
        action="load"
        fontFamily="comic_sans"
        hoverTextColor="0.5, 0.5, 0.5, 1.0"
        textShadow="2,2 0 0,0,0,1.0"
    >
        Load
    </button>
    <button 
        id="exitBtn" 
        x="50" y="470" 
        scale="1.0" 
        color="1.0,1.0,1.0" 
        action="exit"
        fontFamily="comic_sans"
        hoverTextColor="0.5, 0.5, 0.5, 1.0"
        textShadow="2,2 0 0,0,0,1.0"
    >
        Exit
    </button>
</main_screen>